from math import pi as pi_number
figure = input()

area = 0

if figure == "square":
    side = float(input())

    area = side * side


elif figure == "rectangle":
    side_a = float(input())
    side_b = float(input())

    area = side_a * side_b

elif figure == "circle":

    radius = float(input())
    area = radius * radius * pi_number

elif figure == "triangle":
    width = float(input())
    height = float(input())

    area = width * height / 2

print(f"{area:.3f}")
