PUZZLE_PRICE = 2.60
TALKING_DOLL_PRICE = 3
BEAR_PRICE = 4.10
MINION_PRICE = 8.20
TRUCK_PRICE = 2

trip_price = float(input())
count_puzzles = int(input())
count_talking_dolls = int(input())
count_bears = int(input())
count_minions = int(input())
count_trucks = int(input())

total = (count_puzzles * PUZZLE_PRICE) + (count_talking_dolls * TALKING_DOLL_PRICE) + (count_bears * BEAR_PRICE) + (count_minions * MINION_PRICE) + (count_trucks * TRUCK_PRICE)


total_count_toys = count_puzzles + count_talking_dolls + count_bears + count_minions + count_trucks

if total_count_toys >= 50:

    total -= total * 0.25


total -= total * 0.10


if total < trip_price:
    diff = trip_price - total
    print(f"Not enough money! {diff:.2f} lv needed.")

else:
    diff = total - trip_price
    print(f"Yes! {diff:.2f} lv left.")
